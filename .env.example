# =============================================================================
# NEXT.JS APP CONFIGURATION (for local development / Vercel)
# Copy this to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Credentials for Lambda Invocation (Next.js API route signs requests)
# -----------------------------------------------------------------------------
# Option 1: AWS Access Keys (recommended for Vercel)
# Set these in Vercel Environment Variables dashboard
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 2: AWS Profile (for local development only)
# AWS_PROFILE=default

# Required: AWS Region where your Lambda function is deployed
AWS_REGION=us-east-2

# Required: Lambda function ARN or name to invoke
LAMBDA_FUNCTION_NAME=arn:aws:lambda:us-east-2:098876901014:function:pavukanez-backend-openrouter

# Optional: Lambda Function URL for streaming (create with AWS_IAM auth)
# LAMBDA_FUNCTION_URL=https://your-function-url.lambda-url.us-east-2.on.aws

# -----------------------------------------------------------------------------
# Upstash Redis (optional - for distributed rate limiting in Next.js middleware)
# Rate limits /api/lambda/invoke to 60 req/min per IP
# Create database at https://console.upstash.com/redis
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# =============================================================================
# LAMBDA FUNCTION ENVIRONMENT VARIABLES (set in AWS Lambda console)
# These are NOT in .env.local - they are configured on the Lambda itself
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter LLM (REQUIRED)
# Get API key from https://openrouter.ai/keys
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-xxxxx
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Upstash Redis for Search Tool Rate Limiting & Caching (REQUIRED for search)
# Separate from Next.js middleware Upstash - used by Lambda function
# 30 req/min rate limit + 1hr cache TTL for search results
# Create database at https://console.upstash.com/redis
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# -----------------------------------------------------------------------------
# Search Tool Configuration (optional, have defaults)
# -----------------------------------------------------------------------------
# SEARCH_RATE_LIMIT=30          # requests per minute per IP
# SEARCH_CACHE_TTL=3600         # cache TTL in seconds (1 hour)
# SEARCH_MAX_RESULTS=5          # max results per search
# MAX_TOOL_CALLS=3              # max tool calls per conversation