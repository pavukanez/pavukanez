# AWS Configuration for Lambda Invocation
# Copy this to .env.local and fill in your values

# Required: AWS Region where your Lambda function is deployed
AWS_REGION=us-east-1

# Required: Name of the Lambda function to invoke
LAMBDA_FUNCTION_NAME=your-lambda-function-name

# Option 1: Use AWS Access Keys (recommended for Vercel)
# Set these in Vercel Environment Variables dashboard
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 2: Use AWS Profile (for local development only)
# AWS_PROFILE=default