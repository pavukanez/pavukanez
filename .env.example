# AWS Configuration for Lambda Invocation
# Copy this to .env.local and fill in your values

# Required: AWS Region where your Lambda function is deployed
AWS_REGION=us-east-1

# Required: Name of the Lambda function to invoke
LAMBDA_FUNCTION_NAME=your-lambda-function-name

# Option 1: Use AWS Access Keys (recommended for Vercel)
# Set these in Vercel Environment Variables dashboard
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 2: Use AWS Profile (for local development only)
# AWS_PROFILE=default

# Lambda Function URL (for streaming support)
# Create with: aws lambda create-function-url-config --function-name YOUR_FUNCTION --auth-type AWS_IAM --region YOUR_REGION
# LAMBDA_FUNCTION_URL=https://your-function-url.lambda-url.us-east-1.on.aws

# Sandbox Security (required for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SANDBOX_API_KEY=your-secure-random-key-here
# NEXT_PUBLIC_SANDBOX_API_KEY=your-secure-random-key-here (client-side, same value)

# Upstash Redis for Distributed Rate Limiting (required for production)
# Create database at https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# Option 2: Use AWS Profile (for local development only)
# AWS_PROFILE=default